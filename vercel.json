{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "services": {
    "frontend": {
      "root": "frontend/",
      "framework": "express",
      "bindings": [
        {
          "type": "service",
          "service": "backend",
          "format": "url",
          "env": "DHRUVURJA_BACKEND_URL"
        }
      ]
    },
    "backend": {
      "root": "backend/",
      "framework": "fastapi",
      "entrypoint": "main:app"
    }
  },
  "rewrites": [
    {
      "source": "/(.*)",
      "destination": {"service": "frontend"}
    }
  ]
}
